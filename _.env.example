# ============================ Gemini ============================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# ============================ Sources ===========================
# Comma-separated lists. Leave a list empty to disable that source.
RSS_FEEDS=https://feeds.bbci.co.uk/news/technology/rss.xml,https://techcrunch.com/feed/
TELEGRAM_CHANNELS=durov,telegram
TWITTER_USERNAMES=

# Telegram (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# Twitter/X API v2 bearer token (optional; paid/limited access)
TWITTER_BEARER_TOKEN=

# ============================ Blogger ===========================
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_SECRETS=client_secret.json
BLOGGER_TOKEN_FILE=data/blogger_token.json
# true = save as draft (safe default), false = publish live
PUBLISH_AS_DRAFT=true

# ============================ Pipeline ==========================
RUN_INTERVAL_MINUTES=60
FETCH_LIMIT_PER_SOURCE=10
MAX_POSTS_PER_RUN=3
ITEM_MAX_AGE_HOURS=24
MIN_TEXT_LENGTH=80
MAX_RETRIES_PER_ITEM=3
DELAY_BETWEEN_POSTS_SECONDS=10
LOG_LEVEL=INFO
